# Bí mật stack platform — sao chép thành .env trên VM (KHÔNG commit .env thật).
POSTGRES_PASSWORD=change-me-strong
LITELLM_MASTER_KEY=sk-lsr-master-change-me
COLLECTOR_INGEST_TOKEN=lsr-collector-change-me
PLATFORM_ADMIN_TOKEN=lsr-admin-change-me

# Khoá Anthropic gốc — do bạn tự dán trên VM (không đặt vào repo).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# App Lark theo squad (routing_binding.app_id) — mỗi app 1 cặp; secret CHỈ nằm trên VM.
# Điền xong: sudo docker compose up -d platform_api event_gateway_<tên>
SAWADEE_LARK_APP_ID=cli_aaf6d2b3a5b8ded3
SAWADEE_LARK_APP_SECRET=REPLACE_ME
SOURCING_LARK_APP_ID=cli_aaf6ce7c8d38deed
SOURCING_LARK_APP_SECRET=REPLACE_ME
DATA_LARK_APP_ID=cli_REPLACE_ME
DATA_LARK_APP_SECRET=REPLACE_ME
# Magic LSR (squad FA — AG-HARRY)
HARRY_LARK_APP_ID=cli_aaf6ce3008b8ded3
HARRY_LARK_APP_SECRET=REPLACE_ME

# ADMIN APP của platform (hoạt động THỰC: OAuth console, notify, bot broker mặc định).
# Minh Anh chỉ là app DEMO. Nạp secret bằng: bash scripts/add-lark-app.sh NOTIFY cli_aaff13891ff85ee6 platform_api
LARK_NOTIFY_APP_ID=cli_aaff13891ff85ee6
LARK_NOTIFY_APP_SECRET=REPLACE_ME

# P10: đăng nhập console qua Lark OAuth (dùng app LARK_NOTIFY/MINH_ANH ở trên).
# Nhớ khai redirect URI trong Lark Developer Console: <CONSOLE_BASE_URL>/api/auth/lark/callback
CONSOLE_BASE_URL=https://app.34-126-154-135.sslip.io
ALLOWED_LOGIN_DOMAINS=hapas.vn
# tenant_key của org (chặt hơn domain email) — lấy từ audit log sau lần đăng nhập Lark đầu tiên
LARK_TENANT_KEY=
# Quyền mặc định cho mọi tài khoản đã đăng nhập, trên mọi agent (user = chỉ xem)
DEFAULT_LOGIN_ROLE=user
