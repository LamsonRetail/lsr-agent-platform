# Caddy — HTTPS công khai cho Platform API + Collector (để Vercel cloud gọi được).
# Domain sslip.io theo IP VM (34.126.154.135). TLS tự động (Let's Encrypt).
# Bảo vệ:
#  - /health: mở (không cần token) để kiểm tra uptime.
#  - còn lại: bắt buộc header X-Gateway-Token đúng, thiếu -> 403.
#  - rate-limit theo IP: 120 request / phút.

{
	email admin@lamsonretail.vn
	order rate_limit before basicauth
}

(guard) {
	# {args[0]} = upstream, {args[1]} = tên zone rate-limit
	@health path /health
	handle @health {
		reverse_proxy {args[0]}
	}
	handle {
		rate_limit {
			zone {args[1]} {
				key {remote_host}
				events 120
				window 1m
			}
		}
		route {
			@bad not header X-Gateway-Token {$LSR_GATEWAY_TOKEN}
			respond @bad "forbidden" 403
			reverse_proxy {args[0]}
		}
	}
}

platform.34-126-154-135.sslip.io {
	# Self-service: enroll + bootstrap + agent-scoped API (/v1/self*). Mở (không cần
	# gateway token); auth ở app (enroll token / agent telemetry key). Vẫn rate-limit.
	@selfserve path /v1/agents/enroll /bootstrap/* /v1/self /v1/self/* /v1/lark/* /v1/chat/* /v1/auth/device/* /v1/auth/me
	handle @selfserve {
		rate_limit {
			zone zenroll {
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy platform_api:8090
	}
	handle {
		import guard platform_api:8090 zplatform
	}
}

collector.34-126-154-135.sslip.io {
	# Data-plane cho agent bên ngoài: xác thực bằng telemetry key (Bearer) ở collector,
	# không cần gateway token. Còn lại (resources/stats...) vẫn cần gateway token.
	@agent path /v1/traces /v1/policy/check
	handle @agent {
		rate_limit {
			zone zagent {
				key {remote_host}
				events 240
				window 1m
			}
		}
		reverse_proxy collector:8081
	}
	handle {
		import guard collector:8081 zcollector
	}
}

# UI backend (Next.js). Console đã có đăng nhập riêng (Lark OAuth + RBAC + middleware),
# basic-auth chỉ còn là lớp ngoài tạm thời cho các trang nội bộ.
# 3 path đăng nhập PHẢI mở: người trong org tự login bằng Lark và tự duyệt CLI (/device)
# mà không cần ai đưa mật khẩu dùng chung. Các trang này vẫn tự bảo vệ bằng session:
# chưa đăng nhập thì /device không duyệt được gì (401) và middleware đá về /login.
app.34-126-154-135.sslip.io {
	@openauth path /login /login/* /device /device/* /api/auth/*
	handle @openauth {
		reverse_proxy web:3000
	}
	handle {
		basic_auth {
			lamson $2a$14$mCnOcSgMWnhjsG1AKdZwqOG./Itm3V1e41xA1AeuZUYCk5TsXDody
		}
		reverse_proxy web:3000
	}
}
