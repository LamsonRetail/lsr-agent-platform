# Copy thành .env rồi điền (KHÔNG commit .env). Chi tiết cách lấy từng giá trị: SETUP.md

# --- Platform ---
# Nhận khi enroll (PLAN §2.2: lsr-login.sh → enroll). Runtime chính thức của platform
# truyền token bằng tên LSR_TELEMETRY_API_KEY — code nhận cả hai tên.
LSR_AGENT_TOKEN=lsr_tel_...
# LSR_PLATFORM_URL=https://platform.34-126-154-135.sslip.io
# LSR_ENV=prod                       # môi trường đọc instruction_block

# --- Pháp chế in the loop ---
# Group nhận thông báo + nhận lệnh phê duyệt (chốt 17/08/2026). Bot phải là member.
LEGAL_GROUP_CHAT_ID=oc_2c44821d37e5e12a2c1651251cfd4efb
# GATE_SLA_HOURS=4                   # quá hạn: gate thì NHẮC, observe thì tự thông
# GATE_TICK_MIN=10                   # chu kỳ quét SLA + nạp lại instruction

# --- Lark (CHỈ để đọc/ghi Wiki-Drive — ngoại lệ C1; gửi/nhận tin đi qua platform) ---
# App GỬI TIN qua broker. ⚠️ PHẢI là app có bot **ở trong group** — đo 21/08: bot trong
# group `LSR Legal - admin group` là app RIÊNG của AG-LEGAL (`cli_aa0f9ac50cf8dee9`),
# không phải app Admin dùng chung. Để RỖNG = dùng app Admin ⇒ gửi bị 502
# "Bot/User can NOT be out of the chat" và MẤT TOÀN BỘ thông báo.
LARK_BOT_APP_ID=cli_aa0f9ac50cf8dee9
# App RIÊNG của AG-LEGAL, CHỈ để đọc/ghi Wiki-Drive (không dùng để gửi tin)
LARK_APP_ID=cli_...
LARK_APP_SECRET=...
# LARK_BASE=https://open.larksuite.com
# LARK_TENANT_DOMAIN=o4pvcegwn6b.sg.larksuite.com
# LEGAL_WIKI_SPACE_ID=7595876759661186785
# LEGAL_DRIVE_FOLDER=GUYFfiGeqlnyiOd8rU9lMLDvgwf   # "Van ban luat" (đọc + GHI)

# --- Gọi tên & nghe (Ann trong nhóm) ---
# Chat_id được coi là NHÓM → chỉ trả lời khi có ai gọi tên/@mention.
# Thường KHÔNG cần khai: agent tự nạp danh sách nhóm qua `/v1/lark/chats` mỗi chu kỳ
# gate_loop (endpoint đó chỉ trả NHÓM), nên add bot vào nhóm mới là nhận ra ngay.
# Chỉ khai ở đây khi muốn coi một chat là nhóm TRƯỚC khi bot join.
# (Lark dùng `oc_` cho cả chat riêng lẫn nhóm nên không đoán theo tiền tố được; gateway
#  vẫn chưa truyền `chat_type` — kiểm 21/08, yêu cầu C12.)
AGENT_GROUP_CHAT_IDS=
# Tên/bí danh để nhận ra mình bị gọi (không phân biệt dấu, hoa thường)
# AGENT_NAME_ALIASES=ann,ann nguyen,ann legal,legal agent,ag-legal,trợ lý pháp chế
# Chuyển tin thoại thành chữ. RỖNG = chưa bật → agent nói thẳng là chưa nghe được,
# KHÔNG im lặng. Chờ core mở broker transcribe (C11) hoặc ops dựng service nội bộ.
LSR_TRANSCRIBE_URL=
# VOICE_MAX_SECONDS=600

# --- S5 trình ký: danh tính Lark của agent (C8 — platform giữ token, agent KHÔNG thấy) ---
# Account riêng CHO AGENT (không phải account người thật) — để log Lark phân biệt người/máy.
# Đã cấp quyền 20/08: scope approval read/write, path /open-apis/approval/v4/, refresh 7 ngày.
# RỖNG = agent không tự thấy hồ sơ trình ký (S5 chỉ nhận hồ sơ qua chat).
AGENT_LARK_SUBJECT=ann_legal@hapas.vn
# open_id của chính account agent, trong không gian id của app đã cấp token
# (khác open_id của cùng người dưới app khác!). Để agent không tự mở chat với mình.
AGENT_LARK_OPEN_ID=ou_28c573f04c2adac03df32accd68d2634
# APPROVAL_WATCH=1              # 0 = tắt vòng lặp theo dõi hồ sơ trình ký
# --- Chat dưới danh tính account của agent (poll — Lark không đẩy event cho account người)
# Tự tắt khi chưa đủ quyền, và in ra thiếu tầng nào. Cần HAI thứ, cả hai ở phía core/admin:
#   1. core thêm domain `im` vào _LARK_USER_SCOPES (yêu cầu C14)
#   2. admin mở grant thêm prefix /open-apis/im/v1/ (POST /v1/lark/user/grants)
# USERCHAT_WATCH=1
# USERCHAT_POLL_SECONDS=10
# USERCHAT_CHAT_REFRESH_SECONDS=120
# Chat RIÊNG không có trong API list_chats → agent phải nhắn trước mới có chat_id.
# Ai được chat riêng: khai open_id ở đây, hoặc là thành viên group hạt giống dưới.
# USERCHAT_P2P_OPEN_IDS=
# USERCHAT_SEED_GROUPS=          # rỗng = dùng LEGAL_GROUP_CHAT_ID. ⚠️ KHÔNG khai group
#                                # toàn công ty: mở chat = gửi tin chào tới TỪNG người.
# APPROVAL_TICK_MIN=5           # hồ sơ không tới theo giây; 5 phút đủ nhanh

# --- S2 tạo hợp đồng (Phase 3) ---
# Folder Drive chứa mẫu hợp đồng (.docx + tuỳ chọn <tên>.fields.json).
# Nhận NHIỀU folder, cách nhau bằng dấu phẩy — trong Drive pháp chế có hai folder tên đều
# hợp lý cho mẫu hợp đồng, đoán sai một cái là S2 không thấy mẫu nào mà vẫn báo thành công:
#   B9jvfFfYwlMG16d9Pchlm5npgKc  "Hop dong mau"
#   T8DzfOysElvbf4dMHB7lomb7grc  "Legal - standard agreements"
# Cả hai nằm trong folder cha MIx2fFd8rlzWJBd9bQGlcLQegCd. Chốt 21/08: mẫu ở **Drive**,
# không phải Wiki. Hiện cả hai còn TRỐNG — bỏ mẫu .docx vào là S2 chạy được ngay.
LEGAL_TEMPLATE_FOLDER=B9jvfFfYwlMG16d9Pchlm5npgKc,T8DzfOysElvbf4dMHB7lomb7grc
# Folder con "BAN THAO DRAFT (agent xuat)" nằm TRONG folder mẫu — tách riêng để bản thảo
# không trộn vào kho mẫu (người sau sẽ không biết file nào là mẫu gốc).
LEGAL_DRAFT_FOLDER=NHe5fRCSclUMvNdDmhul5njvg7c

# --- S4 tổng hợp văn bản luật (Phase 5) — HẰNG TUẦN, thứ 2 07:00 ---
# Seed chỉ có nguồn VN. Nước khác thêm trên console agent (chốt 21/08). Văn bản bỏ tay vào
# folder con theo nước trong kho Drive vẫn được index — không cần nguồn tự động.
# Văn bản pháp luật không ra theo giờ; quét mỗi ngày chỉ làm ồn và tốn quota model.
# NEWS_CRAWL=1                  # 0 = tắt thread crawl
# NEWS_WEEKDAY=0                # 0=thứ 2 … 6=CN
# NEWS_HOUR=7
# DIGEST_SLA_HOURS=8            # quá hạn thì NHẮC, không tự phát hành
# Kho văn bản luật = LEGAL_DRIVE_FOLDER ở trên; agent tự tạo folder con theo nước (VN/, TH/)
# ✅ 20/08: folder mới đã có quyền GHI — đã lưu thật PDF ký số + toàn văn .txt.
#
# --- Nguồn (đều lấy được ẨN DANH, không lưu mật khẩu của ai) ---
# chinhphu.vn   kind=chinhphu  số hiệu từ cột dữ liệu + PDF KÝ SỐ bản gốc  ← nguồn tốt nhất
# tvpl          kind=tvpl      thuvienphapluat.vn — toàn văn
# luatvietnam   kind=rss       dòng văn bản mới; kind=lvn = tra cứu theo TỪ KHOÁ
# Thêm/sửa nguồn: bảng `legal_news_sources` (sau này làm trên console agent).
# WEB_GAP_SECONDS=2             # giãn cách giữa 2 request CÙNG một host — lịch sự với nguồn
# WEB_TIMEOUT=40
# TVPL_MAX_DOCS=25              # số văn bản mỗi lần chạy
# Chỉ đặt cookie phiên nếu muốn tải thêm file .doc gốc của tvpl (tuỳ chọn):
# TVPL_COOKIE=

# --- NotebookLM (unofficial API — tài khoản Google cá nhân) ---
NLM_NOTEBOOK_KB_ID=...               # notebook "LSR Legal KB" (id trong URL notebook)
NLM_AUTH_PATH=/agent/secrets/notebooklm/storage_state.json
# NLM_AUTH_DIR=./secrets/notebooklm  # thư mục host chứa storage_state.json (mount ro)

# --- Model (auth: subscription — CLI `claude`, KHÔNG API key) ---
# CLAUDE_TIMEOUT=120

# --- Vận hành ---
# KB_SYNC=1                          # 0 = tắt thread sync (khi chạy sync_worker.py tay)
# SYNC_INTERVAL_H=3
# CHAT_WORKERS=3
# LEGALKB_DB=data/legalkb.db
