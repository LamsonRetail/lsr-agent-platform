# Copy thành .env rồi điền (KHÔNG commit .env)

# ---- Lark custom app (lấy ở Lark Developer Console > Credentials) ----
# CHỈ dùng cho lark_link.py (ops kiểm tra liên kết). consumer.py KHÔNG cần secret:
# job Lark vào/ra qua platform, secret nằm trên VM (xem README > Liên kết Lark).
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=
LARK_DOMAIN=https://open.larksuite.com

# ---- Platform (nhận sau khi enroll: scripts/lsr_adopt.py) ----
LSR_PLATFORM_URL=https://platform.34-126-154-135.sslip.io
LSR_AGENT_TOKEN=lsr_tel_...
LSR_TELEMETRY_API_KEY=

DRY_RUN=true
