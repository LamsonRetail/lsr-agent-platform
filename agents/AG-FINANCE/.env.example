# Copy thành .env rồi điền. KHÔNG commit .env.
# Mọi giá trị dưới đây là giả — điền giá trị thật vào .env, không sửa file này.

# ── Platform (xin ở Console hoặc chạy scripts/lsr_adopt.py) ────────────────────
LSR_PLATFORM_URL=https://platform.34-126-154-135.sslip.io
LSR_AGENT_TOKEN=lsr_tel_xxxxxxxx
LSR_AGENT_ID=AG-FINANCE
DRY_RUN=true                       # true = không gửi tin thật ra Lark/Telegram

# ── Chế độ dữ liệu giả ────────────────────────────────────────────────────────
# 1 = dùng data_hub/sources/fake.py, không cần credential nguồn nào — để dev và demo.
# Bỏ trống = dùng nguồn thật. Thiếu credential thì agent nói rõ là chưa truy cập được
# nguồn, KHÔNG âm thầm rơi về số giả.
FIN_FAKE_DATA=

# ── Whitelist squad Finance-Accounting ────────────────────────────────────────
# Để rỗng = TỪ CHỐI TẤT CẢ (fail-closed). Không phải "cho tất cả".
FIN_SQUAD_EMAILS=nguoi1@lamsonretail.vn,nguoi2@lamsonretail.vn
FIN_SQUAD_OPEN_IDS=
FIN_SQUAD_CHAT_IDS=oc_xxxxxxxx     # chat_id nhóm Lark của squad

# ── Google Sheet (Phase 1) ────────────────────────────────────────────────────
GSHEET_CREDENTIALS_JSON=./secrets/gsheet-sa.json
GSHEET_SPREADSHEET_ID=
GSHEET_TAB_RECEIVABLE=
GSHEET_TAB_PAYABLE=
GSHEET_TAB_REVENUE=
GSHEET_TAB_EXPENSE=
GSHEET_TAB_CASHFLOW=

# ── Lark Base FIN-HUB (Phase 1) ───────────────────────────────────────────────
LARK_BASE_APP_TOKEN=
LARK_BASE_TABLE_RECEIVABLE=
LARK_BASE_TABLE_PAYABLE=
LARK_BASE_TABLE_REVENUE=
LARK_BASE_TABLE_EXPENSE=
LARK_BASE_TABLE_CASHFLOW=

# ── MISA AMIS (Phase 2) ───────────────────────────────────────────────────────
MISA_BASE_URL=
MISA_CLIENT_ID=
MISA_CLIENT_SECRET=
MISA_COMPANY_CODE=

# ── Biên bản họp (Phase 3) ────────────────────────────────────────────────────
LSR_TRANSCRIBE_URL=

# ── Ngưỡng coi dữ liệu là cũ (giờ), riêng từng bảng ───────────────────────────
# Quá ngưỡng thì vẫn trả lời nhưng kèm cảnh báo là số cũ. Không khai thì mặc định 24h.
FIN_STALE_HOURS_RECEIVABLE=24
FIN_STALE_HOURS_PAYABLE=24
FIN_STALE_HOURS_REVENUE=720
FIN_STALE_HOURS_EXPENSE=720
