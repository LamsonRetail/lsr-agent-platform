# Copy thành .env rồi điền (KHÔNG commit .env)
LSR_AGENT_TOKEN=lsr_tel_...
LSR_MODEL=claude-sonnet-5
DRY_RUN=true

# Đường dẫn thư mục credential subscription của OWNER trên máy/VPS này (tạo bằng
# `claude setup-token`) — cần cho docker-compose mount vào container. KHÔNG dùng khi
# chạy thẳng `python3 consumer.py` trên máy đã login sẵn.
CLAUDE_CONFIG_DIR=/home/owner/.claude
