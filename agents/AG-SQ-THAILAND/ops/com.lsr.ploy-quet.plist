<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd: chạy BÙ job quét Lark nếu lịch trong app Claude bỏ lỡ ngày.
     Chạy 12:15 và 19:15 — sau giờ lịch chính (08:07) nên bình thường sẽ tự bỏ qua.
     Cài: cp vào ~/Library/LaunchAgents/ rồi launchctl load. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lsr.ploy-quet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/admin/LSR agent/lsr-agent-platform/agents/AG-SQ-THAILAND/ops/quet-lark-neu-thieu.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/admin/LSR agent/lsr-agent-platform/agents/AG-SQ-THAILAND</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>15</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/admin/Library/Logs/ploy-quet.log</string>
  <key>StandardErrorPath</key><string>/Users/admin/Library/Logs/ploy-quet.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/admin/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
