# Copy thành .env rồi điền (KHÔNG commit .env)
LSR_AGENT_TOKEN=lsr_tel_...
DRY_RUN=true

# Phase 2 — model (mặc định off: chạy bằng luật). Bật trên máy đã `claude setup-token`
# bằng subscription của owner. Container mặc định không có CLI → tự về luật.
LSR_MODEL_MODE=off
# LSR_MODEL_NAME=            # để trống = CLI tự chọn theo subscription
# LSR_MODEL_TIMEOUT=90
