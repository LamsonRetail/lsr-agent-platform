# Copy thành .env rồi điền. KHÔNG commit .env (đã gitignore).
# File này CHỈ chứa tên biến và ví dụ vô hại — tuyệt đối không đặt giá trị thật vào đây.

# ================== consumer (hỏi đáp + biên bản họp) ==================
LSR_AGENT_TOKEN=lsr_tel_...
DRY_RUN=true                      # false = gửi tin, tạo Lark Docs và task THẬT

# Ai được xem dữ liệu hạn chế (giá vốn, biên lợi nhuận, chi phí booking KOC, dữ liệu
# người mua). Danh sách open_id hoặc email, phân tách dấu phẩy.
# RỖNG = KHÔNG ai xem được (fail-closed, cố ý).
#
# Owner/người nạp tri thức: Trần Khánh Linh (linhtk@hapas.vn)
#   ou_473c3cf14d3670d73c495db0c706d4c2
# Bắt đầu bằng đúng một người rồi mở dần, đừng đưa cả team vào ngay — mở thì dễ,
# thu lại sau khi số đã bị chụp màn hình gửi đi thì không.
KD_CONFIDENTIAL_VIEWERS=

# Ai được chốt biên bản họp. RỖNG = người gửi recording được coi là chủ trì.
KD_MEETING_CHAIRS=

# ================== App Lark riêng của agent ==================
# Scope cần cấp: wiki:node:read, wiki:space:read, docx:document:readonly,
# docs:document.content:read, bitable:app:read, drive:drive:readonly,
# im:message, im:chat, docx:document:create, task:task:write
LARK_APP_ID=cli_aaf6ca84c5389ed4
# ⚠️ Dán secret vào .env của bạn, KHÔNG điền vào file này và KHÔNG gửi qua chat.
LARK_APP_SECRET=
LARK_DOMAIN=https://open.larksuite.com
# Host tài liệu để dựng link trích dẫn bấm được (đã tra từ Lark của công ty)
LARK_DOC_HOST=https://o4pvcegwn6b.sg.larksuite.com
# Folder Drive chứa biên bản đã chốt (rỗng = My Space của app)
KD_NOTE_FOLDER=

# ================== Transcription server ==================
# BẮT BUỘC khi xử lý recording. Không có mặc định hardcode — hỏi admin URL hiện tại.
LSR_TRANSCRIBE_URL=

# ================== kd_sync (đồng bộ dữ liệu) ==================
PLATFORM_ADMIN_TOKEN=lsr-admin-...
KD_SYNC_HOUR=6

# === GIAI ĐOẠN 1 — nguồn CHÍNH: tài liệu docx/sheet team đang dùng hằng ngày ===
# Khai từng tài liệu, KHÔNG quét cả space (quét cả space kéo về cả file nháp/file cũ).
# "token" lấy từ URL: đoạn sau /wiki/, /docx/ hoặc /sheets/ — code tự phân biệt loại.
# "scope":"agent" cho tài liệu nhạy cảm (P&L, giá vốn, chi phí booking); mặc định shared.
#
# KD_DOCS=[
#   {"token":"AP6ew7BsQiJgH3kzGqMlfCGQgff","label":"KINH DOANH MATE MADE","domain":"kd-report"},
#   {"token":"Hh7Fwh2VpiNUctkhnTylsoCygGf","label":"MATE MADE - BC DAILY","domain":"kd-ops"},
#   {"token":"RYSLw809MiWGC8k7GLmlFKRvgld","label":"B2S - SHOPEE","domain":"kd-ops"},
#   {"token":"JKZUw0CK4iDXbCkhi5ilTNoXgnd","label":"01_SOP","domain":"kd-report"},
#   {"token":"ZNEvwZaKvi9C04kD1FmlkFwmgkJ","label":"TIKTOK ADS","domain":"kd-report"},
#   {"token":"GNSHwzC3aiurVmkXHryli0acgth","label":"JBP DT/CP 2026","domain":"kd-ops","scope":"agent"}
# ]
KD_DOCS=

# Tài liệu lâu hơn ngần này ngày mà chưa ai sửa thì kd_sync in cảnh báo lúc chạy
# (không chặn sync — SOP ít đổi là bình thường; nhưng tài liệu CHỨA SỐ mà cũ thì phải xem lại)
KD_STALE_DAYS=45

# Số dòng đọc tối đa mỗi sheet (sheet báo cáo hay có vài nghìn dòng)
KD_SHEET_ROWS=200

# === GIAI ĐOẠN 2 — khi team dựng được Base "số vận hành hằng ngày" ===
# Base có cột ngày nên chặn được lỗi trả số của kỳ cũ. Bỏ "tables" = lấy mọi bảng.
# KD_BASES=[{"app_token":"bascnXXXX","label":"Số vận hành hằng ngày","tables":[]}]
KD_BASES=

# Folder Drive (tuỳ chọn — quét cả folder, dễ lẫn file rác; ưu tiên KD_DOCS)
# KD_FOLDERS=[{"folder_token":"fldcnXXXX","label":"Báo cáo doanh số"}]
KD_FOLDERS=

# Sync wiki KD hay không. Đọc ghi chú đầu kd_sync.py trước khi bật:
#   AG-LEGAL chưa merge vào main → true (để có tri thức wiki dùng ngay)
#   AG-LEGAL đã merge            → false (tránh mỗi mục wiki có 2 bản trong hàng chờ)
KD_SYNC_WIKI=false
KD_WIKI_SPACE=7496094770155061279
