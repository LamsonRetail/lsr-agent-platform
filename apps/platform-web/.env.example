# Cấu hình web (Vercel env / .env.local) — server-side, KHÔNG lộ ra client.
# Platform API + Collector phải reachable từ nơi chạy web:
#  - Vercel cloud: cần public URL (Caddy+HTTPS / tunnel). Xem README.
#  - Local dev: SSH tunnel tới VM (ssh -L 8090:localhost:8090 -L 8081:localhost:8081 lsr-gcp)
LSR_PLATFORM_URL=http://localhost:8090
LSR_COLLECTOR=http://localhost:8081
PLATFORM_ADMIN_TOKEN=đặt-token-admin-ở-đây
