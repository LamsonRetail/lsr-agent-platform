# ============================================================
# Rating Agent — LamsonRetail | Mẫu biến môi trường
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env vào git.
# ============================================================

# --- Lark Open Platform (Custom App) ---
# Lark quốc tế: https://open.larksuite.com | Feishu (TQ): https://open.feishu.cn
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
LARK_DOMAIN=https://open.larksuite.com
# Token của app Lark Base chứa master data (squads, agents, test...)
LARK_BASE_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxxx

# --- Google BigQuery ---
# Đường dẫn tuyệt đối tới file JSON service account
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BQ_PROJECT_ID=lamsonretail-dwh
BQ_DATASET=dwh
# (tuỳ chọn) location của dataset
BQ_LOCATION=asia-southeast1

# --- Cấu hình chấm điểm ---
# Đường dẫn file YAML trọng số (mặc định: config/scoring_config.yaml)
SCORING_CONFIG_PATH=config/scoring_config.yaml

# Kỳ đánh giá mặc định (YYYY-MM)
EVALUATION_PERIOD=2026-07
